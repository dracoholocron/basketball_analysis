# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=basketball
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=basketball

# ── Redis ──────────────────────────────────────────────────────────────────────
# (no creds needed for dev, but add requirepass in prod)

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_STRONG_SECRET
# Public endpoint for browser-facing presigned (video/output) URLs. Prod: the S3
# subdomain Caddy serves (s3.<DOMAIN>) over HTTPS. Dev: leave as localhost:9000.
MINIO_PUBLIC_ENDPOINT=s3.your-domain.com
MINIO_PUBLIC_SECURE=true

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ── Frontend ───────────────────────────────────────────────────────────────────
# Build-time API base. With Caddy same-origin routing you can leave it as the site
# root (https://<DOMAIN>); the app also works if unset (defaults to same-origin).
NEXT_PUBLIC_API_URL=https://your-domain.com

# ── Caddy ──────────────────────────────────────────────────────────────────────
# Caddy serves <DOMAIN> (app+api) and s3.<DOMAIN> (MinIO). Point both A records here.
DOMAIN=your-domain.com
